      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "3625501481",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"EnableRootAccountAccess\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"kms:*\",\n      \"Resource\": \"*\",\n      \"Principal\": {\n        \"AWS\": \"arn:aws:iam::960577828312:root\"\n      }\n    },\n    {\n      \"Sid\": \"AllowCloudWatchLogsUse\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:ReEncrypt*\",\n        \"kms:GenerateDataKey*\",\n        \"kms:Encrypt*\",\n        \"kms:DescribeKey\",\n        \"kms:Decrypt*\"\n      ],\n      \"Resource\": \"*\",\n      \"Principal\": {\n        \"Service\": \"logs.eu-west-1.amazonaws.com\"\n      },\n      \"Condition\": {\n        \"ArnLike\": {\n          \"kms:EncryptionContext:aws:logs:logGroupArn\": \"arn:aws:logs:eu-west-1:960577828312:log-group:*\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"EnableRootAccountAccess\",\"Effect\":\"Allow\",\"Action\":\"kms:*\",\"Resource\":\"*\",\"Principal\":{\"AWS\":\"arn:aws:iam::960577828312:root\"}},{\"Sid\":\"AllowCloudWatchLogsUse\",\"Effect\":\"Allow\",\"Action\":[\"kms:ReEncrypt*\",\"kms:GenerateDataKey*\",\"kms:Encrypt*\",\"kms:DescribeKey\",\"kms:Decrypt*\"],\"Resource\":\"*\",\"Principal\":{\"Service\":\"logs.eu-west-1.amazonaws.com\"},\"Condition\":{\"ArnLike\":{\"kms:EncryptionContext:aws:logs:logGroupArn\":\"arn:aws:logs:eu-west-1:960577828312:log-group:*\"}}}]}",

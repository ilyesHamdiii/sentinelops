            "override_policy_documents": null,
            "policy_id": null,
            "source_json": null,
            "source_policy_documents": null,
            "statement": [
              {
                "actions": [
                  "kms:*"
                ],
                "condition": [],
                "effect": "Allow",
                "not_actions": [],
                "not_principals": [],
                "not_resources": [],
                "principals": [
                  {
                    "identifiers": [
                      "arn:aws:iam::960577828312:root"
                    ],
                    "type": "AWS"
                  }
                ],
                "resources": [
                  "*"
                ],
                "sid": "EnableRootAccountAccess"
              },
              {
                "actions": [
                  "kms:Decrypt*",
                  "kms:DescribeKey",
                  "kms:Encrypt*",
                  "kms:GenerateDataKey*",

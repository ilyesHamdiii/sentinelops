                "condition": [
                  {
                    "test": "ArnLike",
                    "values": [
                      "arn:aws:logs:eu-west-1:960577828312:log-group:*"
                    ],
                    "variable": "kms:EncryptionContext:aws:logs:logGroupArn"
                  }
                ],
                "effect": "Allow",
                "not_actions": [],
                "not_principals": [],
                "not_resources": [],
                "principals": [
                  {
                    "identifiers": [
                      "logs.eu-west-1.amazonaws.com"
                    ],
                    "type": "Service"
                  }
                ],
                "resources": [
                  "*"
                ],
                "sid": "AllowCloudWatchLogsUse"
              }
            ],
            "version": "2012-10-17"
